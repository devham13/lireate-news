# Lireate News — Cursor Cloud / worker (REG.RU)
# В репозитории только LIREATE_* (FTP_* / SFTP_* здесь не читаются).

CURSOR_API_KEY=

# Публичный сайт
LIREATE_PUBLIC_SITE_URL=

# REG.RU FTP (из ISPmanager → «Настройка FTP-клиента»)
LIREATE_SFTP_HOST=
LIREATE_SFTP_PORT=21
LIREATE_SFTP_USER=
LIREATE_SFTP_PASSWORD=

# Корень после входа по FTP (сверьте в FileZilla)
LIREATE_REMOTE_SITE_ROOT=

# Публикация с агента
LIREATE_ALLOW_PUBLISH=no

# Автопубликация в CMS (см. shared/lireate-autopublish-requirements.md)
# LIREATE_ADMIN_URL=https://example.com/admin/
# LIREATE_ADMIN_USER=
# LIREATE_ADMIN_PASSWORD=
# LIREATE_CMS_HTTP_CONFIG=memory/lireate-cms-http-config.json
# LIREATE_DB_HOST=
# LIREATE_DB_PORT=3306
# LIREATE_DB_NAME=
# LIREATE_DB_USER=
# LIREATE_DB_PASSWORD=

# Опционально
EXCALIBUR_PROJECT_ROOT=

# MCP tokens via env interpolation in mcp.json — never commit real values
# MCP_KV_TOKEN=
