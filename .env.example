# Lireate News — Cursor Cloud / worker (REG.RU only)
# Не используйте FTP_* / SFTP_* / BeGet — только LIREATE_* ниже.

CURSOR_API_KEY=

# Публичный сайт
LIREATE_PUBLIC_SITE_URL=

# REG.RU FTP (из ISPmanager → «Настройка FTP-клиента»)
LIREATE_SFTP_HOST=
LIREATE_SFTP_PORT=21
LIREATE_SFTP_USER=
LIREATE_SFTP_PASSWORD=

# Корень после входа по FTP (сверьте в FileZilla)
LIREATE_REMOTE_SITE_ROOT=

# Публикация с агента
LIREATE_ALLOW_PUBLISH=no

# Опционально
EXCALIBUR_PROJECT_ROOT=

# MCP tokens via env interpolation in mcp.json — never commit real values
# MCP_KV_TOKEN=
