    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l05",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что дешевле: патент или ноу-хау?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На старте ноу-хау дешевле по госпошлинам; патент - от 28 000 руб. за базовую заявку плюс поддержание. Ноу-хау тянет затраты на КТ и споры. Считайте горизонт 10-20 лет."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли совмещать патент и коммерческую тайну?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: каркас в заявке, рецептура и режимы в перечне КТ. Согласуйте формулу с поверенным, чтобы не раскрыть секрет."
          }
        },
        {
          "@type": "Question",
          "name": "Что будет, если опубликовать изобретение до подачи заявки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Новизна обычно теряется. При своем раскрытии подайте заявку за 12 месяцев и докажите цепочку (п. 3 ст. 1350); остальное закройте КТ."
          }
        },
        {
          "@type": "Question",
          "name": "Как долго действует патент на изобретение в России?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "20 лет с подачи при уплате пошлин (ст. 1363). Пропуск пятилетнего платежа грозит прекращением."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли регистрация ноу-хау в Роспатенте?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет, охрана по ст. 1465 и 98-ФЗ, без реестра ведомства."
          }
        },
        {
          "@type": "Question",
          "name": "Когда выгодна осознанная публикация (defensive disclosure)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Когда свой патент не нужен, а чужой узкий патент мешает, и вы готовы отказаться от монополии. Публикуйте полно и учитывайте риск чужой заявки раньше вас."
          }
        },
        {
          "@type": "Question",
          "name": "Защищает ли ноу-хау от того, что конкурент сам разработал то же самое?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет, секрет бьет по разглашению, не по независимому изобретению. Патент запрещает использование по формуле даже при самостоятельной разработке."
          }
        }
      ]
    }
