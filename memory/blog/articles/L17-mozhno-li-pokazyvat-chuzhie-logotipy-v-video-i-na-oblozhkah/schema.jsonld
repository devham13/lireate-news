    {
      "@type": "FAQPage",
      "@id": "#faq-l17",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли поставить чужой логотип на обложку YouTube для привлечения просмотров?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если знак узнаваем и вы продвигаете себя или товар в той же сфере, это близко к использованию товарного знака без согласия. Безопаснее свой макет без чужого обозначения или письменное разрешение."
          }
        },
        {
          "@type": "Question",
          "name": "Чем товарный знак отличается от логотипа в контексте видео?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ТЗ - исключительное право на обозначение в реестре для товаров и услуг. Логотип дополнительно может быть произведением дизайнера. В одном файле на экране вы можете затронуть оба слоя прав."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли указать в описании, что логотип принадлежит компании?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Дисклеймер не заменяет согласие правообладателя на использование по ст. 1484 и 1270 ГК РФ."
          }
        }
      ]
    }
