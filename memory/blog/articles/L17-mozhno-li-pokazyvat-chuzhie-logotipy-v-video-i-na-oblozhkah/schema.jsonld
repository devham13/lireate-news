    {
      "@type": "FAQPage",
      "@id": "#faq-l17",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли использовать чужой логотип в видео без согласия?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от формата. Крупный узнаваемый знак в рекламе ваших услуг или в центре сюжета - близко к использованию товарного знака без согласия (ст. 1484) и воспроизведению графики (ст. 1270). Фоновый кадр без акцента риск снижает, но публичная выкладка не равна случайно попало."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли поставить чужой логотип на превью или обложку YouTube?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если знак узнаваем и вы продвигаете себя или товар в той же сфере, это высокий риск по ТЗ и авторскому праву. Безопаснее свой макет без чужого обозначения, размытие или письменное разрешение правообладателя."
          }
        },
        {
          "@type": "Question",
          "name": "Как законно использовать товарный знак в обзоре и распаковке?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Показывайте оригинальную маркировку на купленном товаре, не подменяйте происхождение и не используйте чужой знак в названии ролика для кликов. Негатив без фактов и реклама мы как бренд X повышают риск претензии."
          }
        },
        {
          "@type": "Question",
          "name": "Как защитить свой логотип от использования в чужих роликах?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зарегистрируйте обозначение как товарный знак в нужных классах МКТУ, закрепите права на графику у дизайнера и фиксируйте нарушения (скрин, ссылка, дата). Досудебная претензия по ст. 1515 и требования по ст. 1301 - типичный следующий шаг."
          }
        },
        {
          "@type": "Question",
          "name": "Чем товарный знак отличается от логотипа в контексте видео?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ТЗ - исключительное право на обозначение в реестре для товаров и услуг. Логотип дополнительно может быть произведением дизайнера. В одном файле на экране вы можете затронуть оба слоя прав."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли указать в описании, что логотип принадлежит компании?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Дисклеймер не заменяет согласие правообладателя на использование по ст. 1484 и 1270 ГК РФ. Он не отменяет претензию при коммерческом использовании знака на обложке или в монтаже."
          }
        }
      ]
    }
  ]
