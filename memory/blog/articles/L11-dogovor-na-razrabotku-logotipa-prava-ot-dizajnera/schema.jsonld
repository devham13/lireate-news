    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l11",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Принадлежит ли мне логотип, если я оплатил счёт дизайнеру?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не автоматически. При заказе у автора-фрилансера исключительное право остаётся у дизайнера, пока вы не подпишете письменное отчуждение или лицензию с нужными способами использования. Проверьте договор и акт; при пустом блоке о правах запросите отдельный договор об отчуждении с ценой."
          }
        },
        {
          "@type": "Question",
          "name": "Чем договор авторского заказа отличается от договора об отчуждении?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Авторский заказ (ст. 1288) регулирует создание логотипа: сроки, правки, приёмка. Отчуждение (ст. 1234) переводит уже существующее исключительное право к вам. На практике их совмещают в одном документе или оформляют заказ, затем акт и отчуждение после утверждения макета."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли передать права на логотип перепиской в Telegram?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для отчуждения нужна письменная форма; чат редко фиксирует цену за права. Подпишите документ с суммой вознаграждения за передачу исключительного права."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли отдельная плата за исключительное право на логотип?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В возмездном отчуждении цена или порядок её определения обязательны. Можно указать одну сумму \"за дизайн и права\" с расшифровкой в договоре или две строки в счёте. Без этого условия договор об отчуждении могут признать незаключённым."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать логотип в Роспатенте без договора с дизайнером?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Заявку подать можно, но при споре с автором или при проверке по п. 9 ст. 1483 вам понадобится согласие правообладателя произведения. Свидетельство на ТЗ не заменяет договор с создателем изображения. Сначала закройте авторские права, затем ищите коллизии в реестре."
          }
        },
        {
          "@type": "Question",
          "name": "Какие файлы должны передать в исходниках?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум вектор (AI, EPS или SVG), PNG без сжатия с прозрачностью, варианты цветной и монохромный, при наличии гайд по отступам и размерам. Попросите подтверждение прав на шрифты и стоки. Список зафиксируйте в акте приёма-передачи."
          }
        },
        {
          "@type": "Question",
          "name": "Заказал логотип у студии - кому принадлежат права по умолчанию?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если договор на создание результата с организацией и исполнитель не лично автор, часто срабатывает п. 1 ст. 1296: право у заказчика, если договором не установлено иное. Всё равно проверьте субподряд и отчуждение от фактических авторов, иначе цепочка для Роспатента будет дырявой."
          }
        }
      ]
    }
  ]
}
