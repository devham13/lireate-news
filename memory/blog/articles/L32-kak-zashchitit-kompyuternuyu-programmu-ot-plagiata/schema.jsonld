    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l32",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Обязательно ли регистрировать программу в Роспатенте, чтобы защитить ее от плагиата?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Авторское право возникает при создании (п. 4 ст. 1259 ГК РФ). Регистрация по ст. 1262 добровольна и фиксирует сведения в реестре; она не блокирует конкурентам разработку похожего функционала на другом коде."
          }
        },
        {
          "@type": "Question",
          "name": "Чем защита программы от плагиата отличается от антиплагиата текста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Антиплагиат ищет совпадения в текстах статей и работ. Здесь объект - исходный код программы для ЭВМ. Другие инструменты, другие доказательства и другие нормы ГК РФ."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли свидетельства Роспатента, чтобы доказать, что конкурент скопировал код?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Свидетельство фиксирует дату депонирования и формальные сведения; в споре сравнивают фрагменты и доказывают доступ нарушителя к вашему коду. Git и договоры часто важнее записи в реестре."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли защитить SaaS, если клиенты не видят исходники?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: закройте репозиторий, договоры с dev и доказательства копирования серверной части или выгруженных скриптов. Публичный API без лицензии - отдельный риск."
          }
        },
        {
          "@type": "Question",
          "name": "Что указать в претензии при незаконном использовании программы для ЭВМ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Объект и версию программы, вашу цепочку прав, конкретные действия нарушителя и расчет по ст. 1301; процент совпадения без экспертной методики не заменяет юридический вывод."
          }
        },
        {
          "@type": "Question",
          "name": "Когда нужен патент, а когда достаточно авторского права на код?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Авторское право охраняет текст кода. Патент на изобретение - техническое решение с новизной; оформление UI и названия продукта - часто товарный знак и иные объекты, не подмена ст. 1261."
          }
        },
        {
          "@type": "Question",
          "name": "Где читать про мобильное приложение и товарный знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Откройте материал о регистрации мобильного приложения - сторы, МКТУ и две заявки там, не в этом чек-листе."
          }
        }
      ]
    }
  ]
}
