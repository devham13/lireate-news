    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l69",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать бренд, если в названии только родовое слово (\"чай\", \"кофе\", \"трава\")?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для однородного перечня - обычно нет по п. 1: слово описывает вид. Меняйте доминирующий элемент или готовьтесь к неохраняемой части; параллельно проверьте п. 6."
          }
        },
        {
          "@type": "Question",
          "name": "Чем доработка названия отличается от доработки логотипа?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Здесь правится слово. Новый рисунок без смены слабого текста не снимает п. 1. Имя согласуйте раньше - нейминг и логотип."
          }
        },
        {
          "@type": "Question",
          "name": "Поможет ли добавить \"магазин\" или \"натуральный\" к слабому имени?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет - это ещё одно описательное слово. Уберите или сместите родовое ядро."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли написать родовое слово латиницей или ЗАГЛАВНЫМИ буквами?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет: смысл и звучание те же. Поищите транслит в Поисковой платформе."
          }
        },
        {
          "@type": "Question",
          "name": "Если имя исправили по п. 1, нужно ли снова искать сходные знаки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. П. 6 отдельно; новое имя тоже может конфликтовать с реестром."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли оставить родовое слово в знаке как неохраняемый элемент?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Иногда, если оно мелкое и не доминирует. Не ставьте родовое слово центром бренда."
          }
        },
        {
          "@type": "Question",
          "name": "Когда имеет смысл платная предоценка ФИПС до подачи?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "При спорном словесном знаке в одном классе - до пошлин заявки (46 200 ₽, 15 раб. дней - ФИПС). Это ориентир, не гарантия."
          }
        }
      ]
    }
  ]
