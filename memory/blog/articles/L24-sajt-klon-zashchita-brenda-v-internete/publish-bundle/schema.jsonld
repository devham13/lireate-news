      "author": { "@id": "#lireate-organization" },
      "publisher": { "@id": "#lireate-organization" }
    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l24",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем сайт-клон отличается от \"просто похожего\" сайта конкурента?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Клон по ТЗ - сходное обозначение и риск смешения источника. Похожая ниша без вашего знака - обычная конкуренция."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли скриншота для суда?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для спора лучше нотариальный протокол осмотра; скриншоты - дополнение, их часто оспаривают по дате."
          }
        },
        {
          "@type": "Question",
          "name": "Кого указать ответчиком: владельца домена или хостинг?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По домену - администратор имени; хостинг - адресат претензии посреднику при нарушении на страницах."
          }
        },
        {
          "@type": "Question",
          "name": "Заблокирует ли Роскомнадзор сайт, если там мой товарный знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не автоматически: один знак без запрещенного содержания не попадает в реестр; нужен иск и иные основания блокировки."
          }
        },
        {
          "@type": "Question",
          "name": "Обязательна ли претензия перед судом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обязательна для компенсации между юрлицами и ИП (30 дней); при пресечении использования - не всегда, но письмо ускоряет удаление."
          }
        },
        {
          "@type": "Question",
          "name": "Какую компенсацию просить по ст. 1515?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Фиксированная сумма в диапазоне закона, двукратная стоимость контрафакта или иной способ из статьи с обоснованием в иске."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли зарегистрированный ТЗ, чтобы защищать только дизайн сайта?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Дизайн без знака чаще идет по авторскому праву на отдельные элементы; для домена и названия в шапке нужен ТЗ или иное основание."
          }
        }
      ]
    }
  ]
