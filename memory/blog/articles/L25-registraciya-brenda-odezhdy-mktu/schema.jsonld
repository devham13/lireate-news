    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l25",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какой класс МКТУ для одежды и продаж?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Изделия - 25 класс. Услуги вашей розницы и продаж через свой сайт или карточки под своей маркой - 35 класс. Текстильные бирки как отдельный товар - 24 класс, позиция 240102. Не подменяйте 25-й только 35-м."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли 35 класс, если продаю только на Wildberries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для своей марки на чужой площадке обычно заявляют и 25 (товар), и 35 (розничные услуги). Продажа через маркетплейс не равна автоматическому \"классу Wildberries\". Уточните формулировки в перечне и в кабинете по гайду для селлеров."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли название и логотип в одной заявке?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, как комбинированный знак в одной композиции. Для независимой смены логотипа подайте две заявки - словесную и изобразительную."
          }
        },
        {
          "@type": "Question",
          "name": "Защищает ли товарный знак дизайн платья?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Внешний вид модели оформляют промышленным образцом, а не словесным знаком. ТЗ закрывает имя и маркировку на бирке и в рекламе."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит минимальная регистрация?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По таблице пошлин: 35 000 ₽ за один класс (до 10 позиций, три этапа оплаты, электронное свидетельство). Пара 25+35 - ориентир 38 500 ₽ по тем же пунктам без бумажного свидетельства."
          }
        },
        {
          "@type": "Question",
          "name": "Где бесплатно проверить название?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В Поисковой платформе Роспатента отметьте классы 25 и 35, сохраните скрин результата перед подачей."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если на WB пожаловались на мой бренд?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Откройте раздел обращений правообладателей и ответьте за 10 дней, приложив свидетельство, договор поставки или лицензию. Без документов карточку могут ограничить даже при честных продажах."
          }
        }
      ]
    }
  ]
