    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l22",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Достаточно ли одного класса 25 для интернет-магазина одежды?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Класс 25 закрывает товары. Продвижение и розничные услуги под тем же именем обычно требуют позиций класса 35. Оцените перечень с поверенным под вашу модель."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать бренд одежды на физлицо?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, заявителем может быть физическое или юридическое лицо. Для производства и договоров с фабрикой удобнее ИП или ООО, но правовой статус заявителя не запрещён."
          }
        },
        {
          "@type": "Question",
          "name": "Чем отличается регистрация бренда от патента на дизайн одежды?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Товарный знак охраняет обозначение; промышленный образец - внешний вид изделия по ст. 1352. Крой и принт могут требовать разных инструментов - см. защиту дизайна товара."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли регистрировать бренд, если продаю только на Wildberries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Запись в справочнике WB не равна ТЗ. Для монополии на имя в стране и для «Оригинала» нужно свидетельство Роспатента."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если экспертиза нашла сходный знак в классе 25?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Варианты: доработать обозначение, сузить перечень, аргументировать несходство/неоднородность, письмо-согласие правообладателя при допустимости. Стратегию выбирают по уведомлению."
          }
        },
        {
          "@type": "Question",
          "name": "Как считаются пошлины за несколько классов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По Положению о пошлинах - базовая плата за первый класс и доплаты за каждый следующий и за позиции перечня. Точные суммы - в таблице Роспатента на дату оплаты."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли использовать имя бренда до завершения регистрации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, но без знака ® до выдачи свидетельства. Риск: за время экспертизы конкурент может подать сходное обозначение - поэтому проверку и подачу лучше не откладывать."
          }
        }
      ]
    }
  ]
