    {
      "@type": "FAQPage",
      "@id": "#faq-l26",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем промышленный образец отличается от товарного знака для формы бутылки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ПО охраняет эстетику корпуса по ст. 1352. Объёмный ТЗ связывает форму с вашим источником, но нужна различительность и обход п. 4 ст. 1483. Выберите инструмент по таблице сравнения в тексте."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать и патент, и ТЗ на одну упаковку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, комбинированная стратегия типична для этикетки: ПО на общий визуальный образ, ТЗ на логотип и слово. Согласуйте объекты, чтобы не получить отказ по пересечению со ст. 1352 п. 5 и ранними знаками."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько действует патент на дизайн?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Базовый срок - 5 лет с даты подачи заявки; продления по 5 лет, не более 25 лет суммарно для заявок после 01.01.2015 (ст. 1363)."
          }
        },
        {
          "@type": "Question",
          "name": "Уже выложил товар на Wildberries - можно патентовать?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Оцените 12 месяцев с момента раскрытия и риск потери новизны; соберите доказательства даты показа. Надёжнее подать заявку до массовой публикации фото на MP и в соцсетях."
          }
        },
        {
          "@type": "Question",
          "name": "Копируют форму, но не логотип - что работает?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Опирайтесь на патент ПО и критерий общего впечатления при сходном назначении (ст. 1358). Один словесный ТЗ не закрывает чужой силуэт."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоят госпошлины на промышленный образец?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ориентир 15 000 ₽ минимум на один вариант (2 000 + 3 000 + 10 000 ₽) по странице ГУ Роспатента; дополнительные образцы в группе удорожают этапы."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли авторское право вместо патента?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AP полезно для графики и разовых макетов, но для серийной формы изделия планируйте регистрацию ПО; AP не заменяет запрет копировать корпус в объёме патента."
          }
        }
      ]
    }
  ]
