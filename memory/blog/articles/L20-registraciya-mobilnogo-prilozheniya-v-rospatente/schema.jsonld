      "author": { "@id": "#lireate-organization" },
      "publisher": { "@id": "#lireate-organization" }
    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l20",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как проходит регистрация программы для ЭВМ для мобильного приложения?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Подайте в Роспатент заявление, реферат (до 900 знаков) и депонируемые материалы - полный исходный текст или фрагменты с нумерацией. Укажите правообладателя и авторов, оплатите пошлину и дождитесь решения (срок госуслуги - 62 рабочих дня). Это отдельная процедура от заявки на товарный знак."
          }
        },
        {
          "@type": "Question",
          "name": "Что даёт свидетельство на приложение как на программу для ЭВМ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Свидетельство по ст. 1262 подтверждает зарегистрированные факты о версии ПО: удобно для суда, инвесторов и досудебных претензий при споре о копировании кода. Оно не запрещает конкурентам похожее имя в сторе - для имени нужен товарный знак."
          }
        },
        {
          "@type": "Question",
          "name": "Как защитить мобильное приложение от копирования кода и имени?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Закройте оба слоя: заявка на программу для ЭВМ - против копирования исходного текста и логики; заявка на товарный знак в классе 9 (и при необходимости 42, 35) - против смешения названия и иконки. Договоры с разработчиками и дизайнером должны передать права заказчику до подачи."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит регистрация программы для ЭВМ в Роспатенте?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Базовая пошлина за рассмотрение заявки на ПО с 01.01.2025 - 5 000 руб. (тарифы на rospatent.gov.ru). Товарный знак тарифицируется отдельно: сумма зависит от числа классов МКТУ и позиций в перечне."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли одной заявкой зарегистрировать и программу для ЭВМ, и товарный знак приложения?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Это разные госуслуги, реестры и комплекты документов. Подайте заявку на ПО с рефератом и фрагментами кода и отдельную заявку на ТЗ с перечнем по МКТУ."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли товарный знак, чтобы опубликовать приложение в App Store или Google Play?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Площадки проверяют правила и политику конфиденциальности, а не свидетельство на ТЗ. Знак нужен, чтобы запретить конкурентам использовать похожее имя в торговле на выбранных классах МКТУ."
          }
        }
      ]
    }
  ]
}
