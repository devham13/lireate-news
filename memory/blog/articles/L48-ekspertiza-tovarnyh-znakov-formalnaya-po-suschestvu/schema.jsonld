    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l48",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько длится формальная экспертиза товарного знака?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По ст. 1498 - 1 месяц со дня подачи (после подтверждения пошлин, если не было запроса). Ответьте на запрос вовремя - иначе отсчёт стоит."
          }
        },
        {
          "@type": "Question",
          "name": "Проверяет ли Роспатент сходство на формальной стадии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Формальная экспертиза смотрит комплект и оформление. Сходство с чужими ТЗ и запреты по ст. 1483 проверяют на этапе экспертизы обозначения (по существу)."
          }
        },
        {
          "@type": "Question",
          "name": "Чем отличается запрос экспертизы от уведомления о предварительном отказе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Запрос (ст. 1497) просит донести сведения - обычно 3 месяца. Уведомление о результатах проверки (п. 3 ст. 1499) сообщает о выявленных препятствиях к регистрации; на доводы - 6 месяцев со дня направления."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько месяцев даётся на доводы по уведомлению по ст. 1499?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "6 месяцев со дня направления уведомления о результатах проверки. Считайте срок от даты в шапке письма Роспатента, а не от дня, когда вы его прочитали в почте."
          }
        },
        {
          "@type": "Question",
          "name": "Что будет, если не ответить на запрос за 3 месяца?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Заявку могут признать отозванной - вы потеряете очередь по этой подаче. Чтобы продлить срок, нужно заранее подать ходатайство и оплатить пошлину продления по таблице пошлин, а не после дедлайна."
          }
        },
        {
          "@type": "Question",
          "name": "Какой максимальный срок экспертизы по существу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По описанию госуслуги - до 12 месяцев с даты принятия заявки к рассмотрению, если не было запросов и уведомлений, которые останавливают отсчёт. Плюс общий лимит услуги 18 месяцев и 2 недели с учётом всех этапов."
          }
        },
        {
          "@type": "Question",
          "name": "Куда смотреть статус экспертизы онлайн?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В кабинете ФИПС (online.rospatent) и Поисковой платформе по номеру заявки. Статус \"формальная\" / \"экспертиза обозначения\" подскажет, какое письмо ждать дальше."
          }
        }
      ]
    }
  ]
}
