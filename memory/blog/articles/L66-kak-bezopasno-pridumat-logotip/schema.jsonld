      "author": { "@id": "#lireate-organization" },
      "publisher": { "@id": "#lireate-organization" }
    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l66",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Достаточно ли поставить © на логотипе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "© напоминает о авторском праве, но не передаёт исключительное право от фрилансера и не заменяет регистрацию ТЗ. Добавьте договор с дизайнером и, при цели - монополия на рынке, заявку в Роспатент."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли взять картинку из интернета и чуть изменить?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет: переработка без согласия автора попадает под риск по ст. 1270 и ст. 1301. Закажите оригинал, купите сток с правом logo/trademark или используйте свой эскиз."
          }
        },
        {
          "@type": "Question",
          "name": "Если шрифт бесплатный, можно ли его в логотипе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Только если EULA прямо разрешает коммерческий логотип. Многие \"free\" гарнитуры ограничивают брендинг - прочитайте файл лицензии, а не название на сайте."
          }
        },
        {
          "@type": "Question",
          "name": "Снимает ли перевод в кривые необходимость лицензии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет: правообладатель шрифта остаётся. Кривые лишь технически фиксируют контур; для суда важна купленная Logo-лицензия или свободная гарнитура."
          }
        },
        {
          "@type": "Question",
          "name": "Чистый поиск в Роспатенте - значит, авторские права тоже чистые?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет: реестр ТЗ не проверяет все произведения и шрифты. Отдельно ведите реестр элементов и договор с автором макета."
          }
        },
        {
          "@type": "Question",
          "name": "Дизайнер на фрилансе нарисовал - логотип уже мой?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Только при письменном отчуждении или лицензии. Оплата счёта без ст. 1234 оставляет права у автора - оформите договор до печати."
          }
        },
        {
          "@type": "Question",
          "name": "Нашёл похожий знак в другом классе МКТУ - это безопасно?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не всегда: оценивайте однородность товаров и риск смешения. При сомнении сохраните поиск и обсудите доработку до тиража."
          }
        }
      ]
    }
  ]
}