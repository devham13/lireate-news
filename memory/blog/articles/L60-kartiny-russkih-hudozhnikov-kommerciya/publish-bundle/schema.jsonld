      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли использовать картину Репина или Шишкина в рекламе без разрешения?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На образ часто да - общественное достояние, но файл и музейный фонд проверяйте отдельно. Для экспонатов из госмузеев закладывайте договор на цифровую копию и письмо по ст. 36 54-ФЗ до запуска таргета."
          }
        },
        {
          "@type": "Question",
          "name": "Картина в общественном достоянии - можно ли взять фото с сайта Третьяковки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет без договора: для коммерции ГТГ требует письменное разрешение. Запрос на tretyakov@tretyakov.ru до тиража."
          }
        },
        {
          "@type": "Question",
          "name": "Чем коммерческое использование отличается от цитирования по ст. 1274?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ст. 1274 - для информационных, научных, учебных и культурных целей с атрибуцией. Реклама, мерч и упаковка сюда не входят. В промо нужна лицензия, а не уменьшенная картинка \"для антуража\"."
          }
        },
        {
          "@type": "Question",
          "name": "Даёт ли покупка репродукции в магазине право печатать её на футболках?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обычно нет: чек - про вещь. Нужна лицензия со способами использования или другой файл."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли согласие музея, если художник умер более 70 лет назад?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да для предметов Музейного фонда по ст. 36 54-ФЗ. ОД не снимает прав на скан музея."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли использовать свой снимок картины в зале музея в рекламе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Личные фото в зале - не коммерческая съёмка. Свой файл не заменяет договор на рекламу и живой срок на автора."
          }
        },
        {
          "@type": "Question",
          "name": "Какую компенсацию могут взыскать за одно изображение в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По ст. 1301 в редакции на дату спора; сверяйте КонсультантПлюс. При сомнении снимите макет и переходите к переговорам."
          }
        }
      ]
