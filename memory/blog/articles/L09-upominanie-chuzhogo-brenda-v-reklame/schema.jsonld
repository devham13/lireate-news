    {
      "@type": "FAQPage",
      "@id": "#faq-l09",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли в рекламе прямо назвать конкурента и сравнить цены?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, если сравнение объективное, цифры проверяемы и нет некорректных превосходных степеней без критерия. Подготовьте расчёт цены за сопоставимую единицу и источник данных."
          }
        },
        {
          "@type": "Question",
          "name": "Законно ли использовать чужой бренд только в ключевых словах Яндекс Директа?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Часто не нарушает исключительное право по 1484, если знака нет в тексте объявления и на лендинге; суды так решали в ряде дел. Риск недобросовестной конкуренции остаётся - проверьте заголовок, быстрые ссылки и сниппет: не должно быть смешения с чужим брендом."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли согласие правообладателя, если я продаю оригинальный товар с его товарным знаком?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "При правомерном вводе товара в оборот в РФ действует исчерпание прав (ст. 1487). Соберите документы поставки; если оформление рекламы имитирует официальный магазин бренда, согласие или смена дизайна всё равно могут понадобиться."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли написать на сайте \"работаем с Apple / Samsung\" и поставить логотипы?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Только с письменного разрешения правообладателя на использование ТЗ в рекламе и на сайте. Без него - претензия по ГК и риск недостоверной рекламы о правах."
          }
        },
        {
          "@type": "Question",
          "name": "Чем отличается спор по товарному знаку в суде от жалобы в ФАС?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Суд по ГК взыскивает компенсацию и требует убрать знак (ст. 1515). ФАС проверяет добросовестность и достоверность рекламы (ст. 5) и может обязать прекратить распространение нарушающего объявления."
          }
        },
        {
          "@type": "Question",
          "name": "Какую компенсацию могут взыскать за незаконное использование знака в баннере?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По ст. 1515 - от 10 000 до 10 000 000 рублей либо двукратный размер стоимости права использования по выбору правообладателя. Суд учитывает характер нарушения и срок."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли упоминать чужой бренд в соцрекламе или благотворительной кампании?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В социальной рекламе упоминание товарных знаков запрещено ч. 4 ст. 10 ФЗ \"О рекламе\". Для иных форматов оценивайте, является ли сообщение рекламой и есть ли согласие правообладателя."
          }
        }
      ]
    }
  ]
}
