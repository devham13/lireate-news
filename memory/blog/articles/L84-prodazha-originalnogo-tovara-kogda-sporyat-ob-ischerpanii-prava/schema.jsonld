    {
      "@type": "FAQPage",
      "@id": "#faq-l84",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Если товар оригинальный, нужно ли разрешение бренда на перепродажу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Отдельная \"лицензия на перепродажу\" чаще не нужна, если законно сработало исчерпание по ст. 1487 или режим ПИ. Докажите ввод в оборот и совпадение партии с документами."
          }
        },
        {
          "@type": "Question",
          "name": "Чем 1487 отличается от параллельного импорта?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1487 - про товары, уже введённые в оборот в РФ. ПИ - про перечень Минпромторга и ввод за рубежом с согласия; иные ограничения по 1252 и 1515 в примечаниях к ним."
          }
        },
        {
          "@type": "Question",
          "name": "Хватит ли одного договора с поставщиком?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обычно нет: запросят связь поставщика с дистрибьютором или правообладателем. Соберите полное звено, как в справке Яндекс Маркета."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли писать бренд в названии карточки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нужно для поиска, но без создания впечатления, что вы - правообладатель, и без чужих фото. Спор о контенте - по 1484, не только по 1487."
          }
        },
        {
          "@type": "Question",
          "name": "Помогает ли таможенная декларация сама по себе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Как часть пакета - да. Как единственный документ при ПИ - часто нет; нужна раскрытая цепочка до согласия правообладателя за рубежом."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если Ozon отклонил документы со ссылкой на 1487?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Уточните, спор о товаре или о карточке. Дозагрузите недостающее звено, исправьте контент, повторите запрос. Параллельно готовьте ответ правообладателю по L02."
          }
        },
        {
          "@type": "Question",
          "name": "Распространяется ли 1487 на ввоз из ЕАЭС?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от цепочки и согласия на ввод в союзе; суды смотрят факты (есть осторожные кейсы, в т.ч. ЕАЭС). Не подменяйте ими текст ст. 1487 без анализа партии."
          }
        }
      ]
    }
  ]
