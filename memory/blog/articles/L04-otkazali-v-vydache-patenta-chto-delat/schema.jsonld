      "author": { "@id": "#lireate-organization" },
      "publisher": { "@id": "#lireate-organization" }
    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l04",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли обжаловать отказ в выдаче патента на изобретение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Сначала возражение в ППС Роспатента в срок до 7 месяцев с учётом запроса копий по п. 3 ст. 1387. После решения ППС при необходимости оспаривайте его в Суде по интеллектуальным правам - только после административной стадии по ст. 1248 ГК РФ."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько времени даётся на ответ экспертизе и на уведомление о патентоспособности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На уведомление - 6 месяцев без продления. На запрос по документам - 3 месяца, до 10 по регламенту. Молчание на формальный запрос 3 месяца ведёт к отзыву."
          }
        },
        {
          "@type": "Question",
          "name": "Что дешевле: возражение в ППС или новая заявка?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Возражение дешевле по госпошлине (3 000 руб. за пункт), но оправдано при сильных доводах. Новая заявка дороже, нужна при смене сути решения."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли патентный поверенный для возражения?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не обязателен: можно самому или по доверенности. При сложной формуле поверенный снижает процессуальные риски."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли продлить срок ответа на уведомление о несоответствии патентоспособности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Планируйте ответ или сужение формулы до истечения 6 месяцев."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если заявку признали отозванной, а не отказали в патенте?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Подайте возражение против отзыва (2 000 руб., п. 1.27.2) или обсудите восстановление по ст. 1389."
          }
        },
        {
          "@type": "Question",
          "name": "Куда идти после неудачи в Палате по патентным спорам?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Оспорьте решение в СИП в сроки АПК или готовьте повторную заявку с новой формулой."
          }
        }
      ]
    }
  ]
}
