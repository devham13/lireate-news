    {
      "@type": "FAQPage",
      "@id": "#faq-l30",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Может ли ИП зарегистрировать товарный знак без патентного поверенного?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. ИП подаёт заявку как гражданин; поверенный не обязателен (ст. 1492 ГК РФ). Ответственность за комплект документов и сроки ответов на уведомления остаётся на заявителе."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит регистрация в одном классе в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум: 35 000 ₽ (пп. 2.1 + 2.4 + 2.11) за один класс до 10 позиций; свидетельство электронное, бумажный экземпляр — п. 2.14 (3 000 ₽) — см. таблицу Роспатента."
          }
        },
        {
          "@type": "Question",
          "name": "Чем online.rospatent отличается от подачи через Госуслуги?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Кабинет ФИПС использует УКЭП. Для подачи личного товарного знака через Госуслуги Роспатент указывает простую электронную подпись. Требования для выбранного профиля уточните в карточке госуслуги на дату подачи."
          }
        },
        {
          "@type": "Question",
          "name": "Какой срок регистрации товарного знака в Роспатенте?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В карточке услуги указано 18 месяцев и 2 недели на полный цикл при стандартном ходе; формальная экспертиза - до 1 месяца, по существу - до 12 месяцев. Срок растягивается при уведомлениях и доводах."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если пришло уведомление от Роспатента?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Подготовьте ответ с доводами и приложениями и направьте в течение 6 месяцев со дня направления уведомления. Пошаговый разбор оснований — в материале об ответе экспертизе при отказе; не пропускайте срок."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли отдельно регистрировать логотип и название?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если нужна охрана и слова, и рисунка как разных объектов - это две заявки (п. 2 ст. 1492). Комбинированный знак в одной заявке защищает сочетание, а не автоматически каждый элемент отдельно."
          }
        },
        {
          "@type": "Question",
          "name": "Вернут ли пошлину при отказе в регистрации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Часть пошлин за поданную заявку и проведённую экспертизу, как правило, не возвращается; возврат возможен только в случаях, прямо указанных в законодательстве о пошлинах. Перед подачей заложите риск отказа, пройдите чек-лист проверки и при необходимости план при занятом знаке, а не только сценарий \"успех\"."
          }
        }
      ]
    }
  ]
}
