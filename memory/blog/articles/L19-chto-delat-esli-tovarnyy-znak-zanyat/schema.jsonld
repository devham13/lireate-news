    {
      "@type": "FAQPage",
      "@id": "#faq-l19",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать похожий товарный знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Иногда да: при несходстве до смешения, неоднородных товарах или письменном согласии правообладателя по п. 6 ст. 1483."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если занят только логотип, а слово свободно?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Разделите словесную и изобразительную части и повторите поиск по изображению; одной смены шрифта может быть недостаточно."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли договора купли-продажи бренда без Роспатента?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет: исключительное право у записанного в реестре правообладателя; нужна регистрация перехода или лицензии."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит смена бренда?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от упаковки, рекламы, домена и маркетплейсов; сравните смету ребренда с пошлинами новой заявки."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли использовать имя, если знак в другом классе МКТУ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Иногда да, но проверьте однородность позиций перечня, а не только номер класса."
          }
        },
        {
          "@type": "Question",
          "name": "Что быстрее: согласие правообладателя или оспаривание его знака?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Согласие при готовности сторон часто быстрее; оспаривание по ст. 1512 длится месяцы и требует пошлину 14 000 руб."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли заново проверять альтернативное имя перед подачей?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, полный поиск по каждому финальному варианту перед подачей заявки."
          }
        }
      ]
    }
