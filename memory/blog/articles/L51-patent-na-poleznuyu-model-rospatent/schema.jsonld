      "author": { "@id": "#author-artur-horoshev" },
      "publisher": { "@id": "#lireate-organization" }
    },
    {
      "@type": "HowTo",
      "@id": "#howto-l51",
      "name": "Патент на полезную модель в Роспатенте: как запатентовать изделие и какие документы нужны",
      "description": "Предпатентный поиск, пакет по ст. 1376 и Приказу № 701, одновременная подача, пошлины п. 1.2 и 1.9, формальная и автоматическая экспертиза по существу (ст. 1390), п. 1.17 и поддержание по п. 1.20.2 на 6–10-й годы.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Предпатентный поиск",
          "text": "Сверьте устройство и признаки в реестрах ФИПС и Поисковой платформе Роспатента до подготовки формулы."
        },
        {
          "@type": "HowToStep",
          "name": "Подготовка описания, формулы, чертежей и реферата",
          "text": "Оформите документы по ст. 1376 и структуре разделов Приказа Минэкономразвития № 701."
        },
        {
          "@type": "HowToStep",
          "name": "Одновременная подача заявки",
          "text": "Передайте заявление, описание и чертежи (если на них ссылка) вместе, чтобы дата подачи не перенеслась на последний документ (п. 3 ст. 1376)."
        },
        {
          "@type": "HowToStep",
          "name": "Оплата п. 1.2 и 1.9",
          "text": "Уплатите пошлины за регистрацию заявки с формальной экспертизой и за решение по экспертизе по существу одновременно (5 000 ₽ при не более 10 пунктах формулы) до старта экспертизы по существу."
        },
        {
          "@type": "HowToStep",
          "name": "Ответы на запросы ФИПС",
          "text": "На дополнительные материалы по существу отвечайте в течение 3 месяцев, иначе заявку отзовут."
        },
        {
          "@type": "HowToStep",
          "name": "Регистрация и публикация патента",
          "text": "При положительном решении уплатите п. 1.17 (10 000 ₽ за электронный патент и годы 1–5); бумажный патент — дополнительно 3 000 ₽ по п. 1.18.1."
        },
        {
          "@type": "HowToStep",
          "name": "Поддержание прав на 6–10-й годы",
          "text": "Планируйте ежегодные платежи по п. 1.20.2 с 6-го по 10-й год с даты подачи, иначе патент прекратят."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l51",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли запатентовать идею без устройства?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Нужно техническое решение устройства с описанием и формулой (ст. 1351 ГК РФ). Идея без конструкции не подаётся; способ оформляют как изобретение, бренд — отдельным треком товарного знака."
          }
        },
        {
          "@type": "Question",
          "name": "Чем полезная модель проще или слабее изобретения?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проще по критериям и автоматической экспертизе по существу (ст. 1390). Слабее по сроку (10 лет) и не охраняет способ."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоят госпошлины на полезную модель до патента в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "При не более 10 пунктах формулы и электронном патенте ориентир 15 000 ₽: п. 1.2 (2 000 ₽) + 1.9 (3 000 ₽) + 1.17 (10 000 ₽) по таблице Роспатента. Бумажный патент — дополнительно 3 000 ₽ (п. 1.18.1)."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли патентный поверенный физлицу в России?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не обязателен: резидент ведёт дела сам (п. 1 ст. 1247). Иностранцу без поверенного обычно нельзя. Поверенный экономит время при сложной формуле и запросах ФИПС."
          }
        },
        {
          "@type": "Question",
          "name": "Какие документы обязательны в заявке на полезную модель?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Заявление, описание, формула, чертежи (если нужны для понимания), реферат (ст. 1376). Структура разделов — Приказ № 701."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько времени после выставки, чтобы подать заявку на ПМ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "6 месяцев с даты вашего раскрытия, если хотите сохранить льготу (п. 3 ст. 1351). У изобретения — 12 месяцев; не путайте в календаре."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько действует патент на полезную модель?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "10 лет со дня подачи заявки (ст. 1363). Дальше — пошлины п. 1.20.2 за 6–10-й годы или прекращение прав."
          }
        }
      ]
    }
  ]
