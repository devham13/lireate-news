    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l74",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как защитить интеллектуальные права в суде?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Определите объект и статус правообладателя, выберите требования по п. 1 ст. 1252 и спецнорму компенсации, зафиксируйте нарушение по п. 55 ППВС № 10, направьте претензию при денежном иске между ЮЛ и ИП, выдержите 30 дней, подайте иск в арбитраж с пошлиной и полным приложением доказательств."
          }
        },
        {
          "@type": "Question",
          "name": "Как подать в суд за нарушение интеллектуальной собственности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сначала досудебный порядок для денежных требований ЮЛ/ИП, затем иск по АПК с ценой иска и копией ответчику; подсудность - арбитраж или СИП по категории."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать при нарушении интеллектуальной собственности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Фиксируйте факты, проверьте документы о праве, претензия при цели взыскать деньги, жалоба на площадку при МП, не пропускайте трехлетнюю давность."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли претензия, если требую только удалить контент?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По п. 5.1 ст. 1252 для пресечения претензия не обязательна, но письмо с требованием часто ускоряет удаление."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли в одном иске потребовать компенсацию и убытки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет, за одно нарушение - один денежный способ (ППВС № 10, п. 59)."
          }
        },
        {
          "@type": "Question",
          "name": "Какие доказательства суды принимают из интернета?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Скриншоты с URL и временем, нотариальный протокол осмотра, контрольная закупка контрафакта с чеком."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит подача иска в арбитраж?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ориентир: 50 000 ₽ за неимущественное требование организации плюс пошлина по цене иска и сопутствующие расходы."
          }
        }
      ]
    }
  ]
}