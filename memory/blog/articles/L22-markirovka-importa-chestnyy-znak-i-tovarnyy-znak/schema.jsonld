    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l22",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Заменяет ли Честный знак регистрацию товарного знака?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. ГИС МТ отвечает за прослеживаемость и контроль оборота; исключительное право на имя и логотип возникает после регистрации в Роспатенте. Пройдите оба трека, если продаёте под своим брендом."
          }
        },
        {
          "@type": "Question",
          "name": "Где наносить код при импорте из Китая и когда - из Казахстана?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Из третьих стран (вне ЕАЭС) Data Matrix наносят до выпуска для внутреннего потребления, если иное не предусмотрено для вашей группы. Из стран ЕАЭС - до фактического пересечения границы РФ; ввод оформляют как трансграничную торговлю, не путайте с сценарием по ДТ."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли GTIN от ГС1 РУС для импортной одежды с собственным брендом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для глобального GTIN, уже присвоенного производителем, регистрация в ГС1 РУС обычно не обязательна. Префиксы 460-469 и правила вашей группы проверьте в инструкции ЦРПТ до заказа кодов."
          }
        },
        {
          "@type": "Question",
          "name": "Что указать в карточке Национального каталога про товарный знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Укажите зарегистрированное обозначение, если свидетельство есть; не присваивайте чужой знак. Согласуйте написание бренда с макетом упаковки и классами МКТУ в Роспатенте."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли ввезти партию на таможенный склад и промаркировать в России?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для ряда групп допустимы транзит или склад до нанесения, но только в рамках процедур, описанных для вашей категории на markirovka.ru. Не планируйте розничную продажу до ввода в оборот после выпуска."
          }
        },
        {
          "@type": "Question",
          "name": "Какие штрафы за ввоз без маркировки и чем автоштрафы 2026 отличаются от ст. 15.12?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ст. 15.12 КоАП задаёт базовые санкции за отсутствие маркировки и оборот немаркированного товара. С 01.09.2026 протоколы могут формироваться автоматически по данным ГИС МТ по 120-ФЗ, в том числе за нарушения после системных запретов оборота. Сверьте актуальные суммы в КоАП перед отгрузкой."
          }
        },
        {
          "@type": "Question",
          "name": "Зачем ТРОИС, если товар уже с Data Matrix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "КМ подтверждает легальность вашей промаркированной партии в российском обороте. ТРОИС помогает таможне остановить ввоз партий, нарушающих ваше зарегистрированное ТЗ. Подайте заявление на включение знака в реестр, если риск контрафакта высокий."
          }
        }
      ]
    }
  ]
}
