    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l59",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли добавить бренд на Wildberries без товарного знака?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. \"Создать бренд\" в ЛК не требует свидетельства Роспатента. Для представительства и \"Оригинала\" ТЗ в реестре обязателен."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить, есть ли такой бренд уже на WB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Введите название в \"Создать бренд\": площадка покажет совпадение. Дополнительно сверьте имя в Поисковой платформе и пройдите чек-лист L18, если планируете регистрацию ТЗ."
          }
        },
        {
          "@type": "Question",
          "name": "Какие требования к логотипу бренда на Wildberries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "JPG, 120×50 пикселей, не больше 100 Кб. После смены логотипа заявка снова проходит модерацию."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько длится модерация заявки на бренд?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "До двух рабочих дней. Статусы смотрите в \"Мои бренды → Заявки\"."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли продавать товар, пока бренд на модерации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, если создавали бренд из карточки: карточку можно опубликовать, а поле \"Бренд\" заполнится после одобрения."
          }
        },
        {
          "@type": "Question",
          "name": "Чем \"создать бренд\" отличается от \"стать представителем бренда\"?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "\"Создать бренд\" добавляет запись в справочник для карточек (дни модерации). \"Представитель\" подтверждает права правообладателя (недели, нужен ТЗ в реестре)."
          }
        },
        {
          "@type": "Question",
          "name": "Когда регистрировать товарный знак, если бренд уже есть в ЛК?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Когда растёт узнаваемость, нужна упаковка с защитой имени, статус \"Оригинал\" или готовится сверка с реестром с 01.03.2027. Начните с чек-листа проверки товарного знака перед регистрацией и при необходимости подачи на регистрацию."
          }
        }
      ]
    }
  ]
}
