    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l13",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Художник умер больше 70 лет назад - можно любое фото?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Работа обычно в общественном достоянии, но файл может охраняться. Берите свой снимок в зале (с правилами музея) или JPG с понятной лицензией на сайте коллекции; укажите автора картины. Снимок из Pinterest или агрегатора не становится законным только из-за возраста полотна."
          }
        },
        {
          "@type": "Question",
          "name": "Чем некоммерческий пост отличается от извлечения прибыли?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Реклама услуг и лидогенерация через профиль часто коммерция для ст. 1276. Личный дневник без монетизации ближе к некоммерции, но ст. 1274 требует объём и атрибуцию."
          }
        },
        {
          "@type": "Question",
          "name": "Можно сфотографировать в музее и выложить?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Иногда при своей съёмке, ст. 1276 и правилах зала. Сверьте регламент музея. Файл с сайта - отдельные условия copyright."
          }
        },
        {
          "@type": "Question",
          "name": "Можно брать JPG с сайта Третьяковки или Эрмитажа?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от цели: на сайтах прописаны некоммерция с атрибуцией и письмо на коммерцию. Сохраните скрин условий."
          }
        },
        {
          "@type": "Question",
          "name": "Картина в Google - можно копировать?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Интернет не \"открытое место\"; наличие в сети не даёт права копировать (п. 7 обзора ВС РФ)."
          }
        },
        {
          "@type": "Question",
          "name": "Купил картину - фото в рекламе студии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Вещь ваша, AP на изображение у автора (ст. 1291). Для рекламы - лицензия или пункт в договоре купли-продажи."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно имени художника в подписи?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Имя нужно при цитировании, но не заменяет разрешение на охраняемую работу или чужой профессиональный снимок."
          }
        }
      ]
    }
  ]
