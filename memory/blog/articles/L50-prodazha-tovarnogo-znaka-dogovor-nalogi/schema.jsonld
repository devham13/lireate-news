    {
      "@type": "HowTo",
      "@id": "#howto-l50",
      "name": "Как продать товарный знак: договор отчуждения, запись в Роспатенте и налоговые риски",
      "description": "Due diligence в реестре, согласование цены и договора отчуждения, налоговый расчёт, пошлина 3.11 (15 000 ₽), подача в Роспатент и закрытие рисков после записи в реестре.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Выберите: продажа, лицензия или новая заявка",
          "text": "Для выхода из бренда нужно отчуждение; лицензия сохраняет владельца. Новое имя с нуля — отдельная регистрация, не покупка чужой монополии."
        },
        {
          "@type": "HowToStep",
          "name": "Проверьте знак и риски до переговоров о цене",
          "text": "Сверьте действующую регистрацию (10 лет), МКТУ, залог и лицензии в Поисковой платформе Роспатента; учтите ограничения ст. 1488 п. 2 и NDA до обмена финансовыми данными."
        },
        {
          "@type": "HowToStep",
          "name": "Оцените цену и остаток срока охраны",
          "text": "Привяжите цену к узнаваемости, выручке под брендом и остатку 10-летнего цикла; при крупной сделке — отчёт по ФСО XI."
        },
        {
          "@type": "HowToStep",
          "name": "Найдите покупателя и зафиксируйте намерения письменно",
          "text": "Ищите через брокеров и отраслевые площадки; оформите NDA и LOI с ценой, сроками подачи и распределением пошлины 15 000 ₽."
        },
        {
          "@type": "HowToStep",
          "name": "Согласуйте договор отчуждения и порядок расчётов",
          "text": "Укажите предмет (номер ТЗ), вознаграждение, заверения об отсутствии залога и скрытых лицензий, кто платит п. 3.11; безопасная оплата — аванс и остаток после уведомления о регистрации."
        },
        {
          "@type": "HowToStep",
          "name": "Спланируйте налоги до подписания",
          "text": "Отчуждение облагается по режиму продавца и покупателя: НДС для ООО на ОСНО, доход на УСН, НДФЛ у физлица-продавца; дата признания дохода часто привязана к госрегистрации."
        },
        {
          "@type": "HowToStep",
          "name": "Оплатите пошлину 3.11 и подайте на регистрацию",
          "text": "15 000 ₽ за первый знак и 13 000 ₽ за каждый следующий в заявлении; подайте комплект через госуслугу регистрации распоряжения, ориентир по срокам — до 68 рабочих дней."
        },
        {
          "@type": "HowToStep",
          "name": "Закройте хвосты после записи в реестре",
          "text": "Продавец прекращает использование знака; передайте файлы фирстиля и доступы после регистрации; закройте бухучёт НМА и доходов у сторон."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l50",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли продать товарный знак без регистрации договора в Роспатенте?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет для смены правообладателя. Без госрегистрации переход права не состоялся (ст. 1232 п. 6). Деньги за проданный бренд без подачи в ведомство не дают покупателю монополии в reestre."
          }
        },
        {
          "@type": "Question",
          "name": "Чем продажа отличается от лицензии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "При продаже меняется владелец в реестре; при лицензии — только право пользования. Налоги и документы разные, регистрация в обоих случаях обязательна."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит госпошлина за регистрацию отчуждения одного знака в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "15 000 ₽ по п. 3.11 за первый товарный знак в заявлении; каждый следующий в том же заявлении — +13 000 ₽."
          }
        },
        {
          "@type": "Question",
          "name": "Облагается ли НДС продажа товарного знака у ООО на ОСНО?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Как правило да, по ст. 146 НК РФ со ставкой 20%, если режим не даёт иного. Сверьте с бухгалтером до счёт-фактуры."
          }
        },
        {
          "@type": "Question",
          "name": "Должен ли ИП удерживать НДФЛ, если покупает знак у физлица?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Физлицо-продавец сам исчисляет и платит НДФЛ с дохода от продажи имущественных прав (ст. 228 НК РФ)."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли оценка перед продажей?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не в каждой сделке: для SMB часто хватает цены в договоре. Оценщик — при крупной сделке или вкладе в уставный капитал."
          }
        },
        {
          "@type": "Question",
          "name": "Когда покупатель официально становится правообладателем?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В момент государственной регистрации договора об отчуждении в Роспатенте (ст. 1234 п. 4), а не в день подписания на столе у нотариуса."
          }
        }
      ]
    }
