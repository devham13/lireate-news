    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l36",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что значит \"сниппет\" в сообщении?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Короткий фрагмент текста ошибки на экране, без полного технического контекста. Для решения соберите код ошибки, ID документа в ЛК, исходящий и входящий XML и скрин статуса - так поддержка оператора видит полную картину, а не угадывает по обрывку."
          }
        },
        {
          "@type": "Question",
          "name": "Чем \"Ввезен в РФ\" отличается от производства в РФ в заказе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Это разные способы выпуска в оборот в заявке на коды. Для ввоза нужен вариант про импорт, иначе дальше документ \"Импорт с ФТС\" и таможенная часть не стыкуются с заказом КМ."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли ГС1 РУС для импортного GTIN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Глобальный импортный GTIN часто без ГС1 РУС; для префикса 460-469 обычно нужна регистрация в ГС1. Уточните по группе."
          }
        },
        {
          "@type": "Question",
          "name": "Что с 1 марта 2026 в ЕРВК?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проверка уведомления о начале деятельности при регистрации и при операциях с вводом, оборотом и выводом. У новых участников без уведомления возможен отказ в регистрации; у работающих - предупреждение и дальнейшие действия контролирующих органов по правилам, опубликованным на портале сообщества."
          }
        },
        {
          "@type": "Question",
          "name": "Почему нельзя поправить черновик при attachment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Потому что отказ на стороне обработки вложения из ответа ФТС, а не в поле формы, которое вы могли бы перепечатать. Черновик не меняет тип файла на стороне таможенного контура; нужен разбор по XML или ручной обход в ЛК, если он предусмотрен."
          }
        },
        {
          "@type": "Question",
          "name": "Ошиблись видом документа ввода - что делать?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не дублируйте ввод теми же КМ. Пишите в поддержку или следуйте корректировке для вашей ТГ в ЛК."
          }
        },
        {
          "@type": "Question",
          "name": "Где полный регламент импорта?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Раздел markirovka.ru про импорт и docs.crpt.ru - заказ КМ. Сомневаетесь в графе 31 или классификации - зовите брокера; повтор одной и той же XML-ошибки при нормальной ДТ - интегратора с логом обмена."
          }
        }
      ]
    }
  ]
}
