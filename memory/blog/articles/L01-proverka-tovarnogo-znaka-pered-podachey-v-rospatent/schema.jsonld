    {
      "@type": "FAQPage",
      "@id": "#faq-l01",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как бесплатно проверить товарный знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Используйте Поисковую платформу Роспатента и открытые реестры ФИПС, включая реестр заявок; для международного контура — TMview."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько времени занимает проверка?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для одного знака и 1–2 классов МКТУ — от нескольких часов; при нескольких классах и логотипе — 1–2 рабочих дня."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать похожий знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от сходства и однородности товаров по п. 6 ст. 1483 ГК РФ; другой класс МКТУ не гарантирует регистрацию."
          }
        }
      ]
    }
  ]
