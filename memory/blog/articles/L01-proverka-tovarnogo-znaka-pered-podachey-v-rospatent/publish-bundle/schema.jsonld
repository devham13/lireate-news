    {
      "@type": "FAQPage",
      "@id": "#faq-l01",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как бесплатно проверить товарный знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Откройте Поисковую платформу и открытые реестры на ФИПС, включая реестр заявок. Для импорта и лицензий добавьте TMview. Сохраняйте номера документов и скриншоты - пригодятся поверенному и при доработке знака."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько времени занимает проверка?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Один знак и 1-2 класса - от нескольких часов. Несколько классов и лого - 1-2 рабочих дня. Глубокий анализ сходства чаще уходит на предоценку или поверенного."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать похожий знак?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от сходства и однородности (п. 6 ст. 1483). Другой класс не гарантирует регистрацию. Оцените звук, смысл и графику до подачи."
          }
        },
        {
          "@type": "Question",
          "name": "Чем отличается реестр от Поисковой платформы?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Открытый реестр на ФИПС рассчитан на поиск по номеру документа без масок. Поисковая платформа ищет по слову, изображению и смыслу, показывает заявки и регистрации в одном интерфейсе. Используйте платформу для обнаружения, реестр - для проверки юридического статуса найденного номера."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли платная проверка ФИПС?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не обязательна для подачи заявки. Предварительная оценка охраноспособности - платная услуга (15 рабочих дней, от 46 200 руб. за словесное обозначение и один класс по тарифам на fips.ru). Имеет смысл при спорном сходстве, комбинированном знаке или перед крупными вложениями в бренд и франшизу."
          }
        },
        {
          "@type": "Question",
          "name": "Проверяют ли заявки, а не только регистрации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Реестр заявок на ФИПС и данные Поисковой платформы включают поданные обозначения, по которым экспертиза ещё не завершена. Игнорировать заявки опасно: при одобрении чужой заявки ваш знак может получить отказ."
          }
        },
        {
          "@type": "Question",
          "name": "Вернут ли пошлину при отказе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Только по основаниям Положения о пошлинах (например, за несовершённое действие). Отказ по сходству сам по себе не даёт полного возврата."
          }
        }
      ]
    },
