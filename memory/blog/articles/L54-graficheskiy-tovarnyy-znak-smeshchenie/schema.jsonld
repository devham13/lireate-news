      "author": { "@id": "#lireate-organization" },
      "publisher": { "@id": "#lireate-organization" }
    },
    {
      "@type": "HowTo",
      "@id": "#howto-l54",
      "name": "Как снизить риск смешения: графический товарный знак перед подачей в Роспатент",
      "description": "Поиск по изображению на Поисковой платформе Роспатента, матрица пяти признаков п. 43 Правил № 482, однородность по п. 45, доработка макета и выбор между подачей, согласием и новой заявкой по ст. 1497.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Определите, когда макет уже \"красный\" по графике",
          "text": "Тревожный сигнал - близкое впечатление плюс те же классы МКТУ и риск путаницы. Отличайте слабое сходство в далёком классе от копии в вашем; для графики нужен отдельный файл, даже если в комбинированном лого есть слово."
        },
        {
          "@type": "HowToStep",
          "name": "Подготовьте два файла и классы МКТУ",
          "text": "Экспортируйте полное обозначение как в заявке и файл только графики без словесной части. Ориентир - JPG/TIFF до 3 МБ, классы МКТУ-13–2026 и свой перечень товаров; версии v1/v2 с датой."
        },
        {
          "@type": "HowToStep",
          "name": "Найдите конфликты на Поисковой платформе и в реестре заявок",
          "text": "На searchplatform.rospatent.gov.ru выберите вкладку Изобразительный, загрузите JPG полного знака и только графики, добавьте коды Венской классификации, отберите 5-15 ближайших знаков и проверьте реестр заявок на fips.ru по номерам из красной зоны."
        },
        {
          "@type": "HowToStep",
          "name": "Заполните таблицу пяти признаков п. 43 Правил № 482",
          "text": "Сравните внешнюю форму, симметрию, смысловое значение, характер изображения и цвет с чужими знаками по отдельности и в сочетании. На каждый опасный номер - строка матрицы; два и более признака в однородных товарах требуют плана правок."
        },
        {
          "@type": "HowToStep",
          "name": "Учтите комбинированный знак и доминирующий элемент",
          "text": "Для комбинированного знака учитывайте п. 44 и доминанту по размеру, центру и контрасту. Делайте поиск только графики и текстовый поиск по слову; абсолютные правки - в гайде L39, здесь - сходство с чужим знаком."
        },
        {
          "@type": "HowToStep",
          "name": "Проверьте однородность товаров по п. 45",
          "text": "Однородность - род, вид, назначение, каналы сбыта и круг потребителей. Сравните перечни МКТУ; сужение перечня помогает, но не при копии силуэта."
        },
        {
          "@type": "HowToStep",
          "name": "Снизьте визуальный риск: приёмы доработки макета",
          "text": "Меняйте силуэт, симметрию, образ и стиль, затем палитру; сохраните v2 и повторите поиск. Привязывайте каждую правку к признаку п. 43; одной смены цвета при совпавшей форме обычно недостаточно."
        },
        {
          "@type": "HowToStep",
          "name": "Выберите: подача, согласие, сужение классов или новая заявка",
          "text": "После правок с 0-1 признаком п. 43 в однородных классах - подача; при сохранении конфликта и лояльном правообладателе - письмо-согласие по п. 46; при сходстве в части товаров - сужение МКТУ; при спорной зоне - предоценка 46 200 ₽; при смене доминирующей графики - новая заявка по ст. 1497."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l54",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Почему поиск по картинке всегда находит похожие знаки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Алгоритм сортирует по близости контуров. Нулевой выдачи ждать не стоит - сужайте список по классам и оценивайте п. 43 вручную."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли отдельно проверять слово в комбинированном логотипе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: файл \"только графика\" плюс текстовый поиск по слову на платформе (L01)."
          }
        },
        {
          "@type": "Question",
          "name": "Какие пять признаков сравнивает Роспатент для изобразительных знаков?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По п. 43: внешняя форма, симметрия, смысловое значение, характер изображения (натуралистическое, стилизованное и т.д.), сочетание цветов и тонов. Их учитывают по отдельности и вместе."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли сменить только цвет, чтобы снизить риск смешения?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Часто нет: если совпали силуэт и образ, смена палитры может не снять ассоциацию \"в целом\". Сначала меняйте форму или смысл, затем цвет и повторяйте поиск."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли доработать логотип после подачи заявки без новой заявки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Несущественные правки иногда допускаются, но графическое или смысловое изменение основного изобразительного элемента или ключевых цветов ведёт к ст. 1497 - нужна самостоятельная заявка. До подачи проще и дешевле пройти матрицу из этой статьи."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое письмо-согласие и когда оно уместно для похожего логотипа?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Это добровольное разрешение правообладателя чужого знака на регистрацию сходного обозначения в согласованных пределах (п. 46). Уместно, когда правки не снимают сходство, но владелец старшего знака не против и нет риска заблуждения потребителей."
          }
        },
        {
          "@type": "Question",
          "name": "Когда нужна платная предоценка охраноспособности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если самопроверка не даёт уверенности: крупный конкурент, спорная однородность, дорогой ребренд. У ФИПС платная предоценка по одному классу - 46 200 ₽ по сводке тарифов ГАРАНТ на дату обращения; это заключение ведомства, а не замена вашего дизайнерского поиска."
          }
        }
      ]
    }
  ]
}
