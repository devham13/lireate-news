    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l10",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Является ли доменное имя нематериальным активом по ФСБУ 14/2022?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Отдельно - редко. Чаще - в 08 в составе сайта при первой регистрации или расход на продление. Сверьте все признаки п. 4 и политику."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли учесть домен на счёте 04 отдельно от сайта?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет для эксплуатируемого имени: 04 - поиски. Рабочий домен - 08 с сайтом, 26/44/97 на продление или забаланс."
          }
        },
        {
          "@type": "Question",
          "name": "Куда списать продление домена - на 26, 44 или 97?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "После ввода сайта в эксплуатацию типично Дт 26 - Кт 60 (или 44, если услуга не привязана к производству). Если учётная политика предусматривает равномерное признание и срок по договору больше месяца, используйте 97. На 08 продление не относите без отдельного обоснования в политике и без выполнения всех признаков п. 4."
          }
        },
        {
          "@type": "Question",
          "name": "Включается ли первичная регистрация домена в стоимость сайта-НМА?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, при создании сайта-НМА: на 08 до принятия сайта вместе с разработкой."
          }
        },
        {
          "@type": "Question",
          "name": "Как учесть покупку домена у прежнего владельца?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Разберите договор (право vs услуга), сверьте сумму с порогом ст. 256 НК и критериями капитализации в БУ."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли регистрировать домен как товарный знак для защиты?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Домен и ТЗ разные. Знак регистрируют в Роспатенте; домен - способ адресации (ст. 1484). Проверьте реестр до покупки имени."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если домен совпадает с чужим товарным знаком?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Оцените однородность и сходство. Возможны досудебные ограничения .ru (14 дней), затем суд. Учёт спор не останавливает - меняйте имя или договаривайтесь."
          }
        }
      ]
    }
  ]
}
