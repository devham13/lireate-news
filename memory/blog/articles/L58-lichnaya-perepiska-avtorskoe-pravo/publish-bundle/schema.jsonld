    },
    {
      "@type": "FAQPage",
      "@id": "#faq-l58",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Является ли обычная переписка в мессенджере объектом авторского права?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Отдельные сообщения могут охраняться, если это не чистый обмен фактами по п. 6 ст. 1259. Рутинные реплики ближе к информации, длинный уникальный текст или вложенное произведение - к авторскому праву. Оценивайте каждое сообщение, а не весь чат целиком."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли выложить скрин, если собеседник сам написал в личку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сам факт переписки не даёт вам право публиковать его слова и данные для неограниченной аудитории. Нужно согласие на воспроизведение и доведение до всеобщего сведения, плюс отдельный контур ПДн и частной жизни. Для отзыва оформите письменное разрешение с площадкой и сроком."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли замазать имя на скриншоте?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Иногда снижает риск по ПДн, но не всегда снимает претензию по тайне переписки и ст. 152.2. Если по должности, истории и аватарке человека узнают, риск остаётся. Лучше сократить цитату или не публиковать вовсе."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли отдельное согласие на публикацию переписки с отзывом клиента?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, если на скрине есть его ФИО, контакты или узнаваемые детали. Согласие на обработку в CRM или чате не заменяет согласие на распространение по ст. 10.1 152-ФЗ. Укажите в документе цель, площадку и перечень данных."
          }
        },
        {
          "@type": "Question",
          "name": "Чем отличается передача переписки в суд от поста в соцсетях?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В процессе материалы направляют органу, который оценит допустимость по ГПК и разъяснениям ВС. Пост в открытой ленте - доведение до всеобщего сведения для всех подписчиков. Суд не \"разрешает\" вам выкладывать тот же скрин публично без иных оснований."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли публиковать переписку с бывшим партнёром из мести?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Высокий риск по частной жизни, тайне переписки и ПДн; мотив \"мести\" ухудшает оценку добросовестности. Публичная выкладка романтической переписки без согласия - красная зона матрицы выше; разумнее юридическая помощь, а не пост."
          }
        },
        {
          "@type": "Question",
          "name": "Что опаснее: нарушение авторского права или раскрытие персональных данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от содержания. Креативная цитата без согласия бьёт по ст. 1301; скрин с ФИО и интимными деталями - по 152-ФЗ и ст. 152.2. Часто срабатывают оба контура сразу. Пройдите все три проверки до клика \"опубликовать\"."
          }
        }
      ]
    }
  ]
}