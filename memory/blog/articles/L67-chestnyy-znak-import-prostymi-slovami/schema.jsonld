      "mainEntity": [
        {
          "@type": "Question",
          "name": "Заменяет ли «Честный знак» регистрацию товарного знака?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Пройдите маркировку в ГИС МТ и введите товар в оборот по закону, а исключительное право на бренд оформляйте в Роспатенте, если продаёте под своим именем."
          }
        },
        {
          "@type": "Question",
          "name": "Где проверить ТН ВЭД на маркировку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Откройте checking_codes на честныйзнак.рф, введите код, затем прочитайте правило товарной группы на markirovka.ru и сверьте дату старта с датой отгрузки партии."
          }
        },
        {
          "@type": "Question",
          "name": "Что писать в «товарный знак» в НК?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Укажите слово с этикетки, зарегистрированное обозначение или формулировку «без знака»; поле не пустое, а чужой известный бренд не делает вас правообладателем."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли ГС1 РУС при заводском GTIN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обычно нет для глобального импортного кода; префиксы 460-469 уточняйте в инструкции."
          }
        },
        {
          "@type": "Question",
          "name": "Когда наносить коды из Китая и из Казахстана?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Китай и вне ЕАЭС — до ФТС; Казахстан и ЕАЭС — до границы, дальше «трансграничная торговля»."
          }
        },
        {
          "@type": "Question",
          "name": "ФТС не выпускает из-за маркировки — что делать?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сверьте отчёт, «Ввезен в РФ» и графу 31; по сбоям — справке docs.crpt.ru."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли сразу продавать на Ozon после таможни?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сначала ввод в оборот, затем требования площадки в инструкции Wildberries по бренду."
